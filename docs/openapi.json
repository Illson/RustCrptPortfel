{
  "openapi": "3.1.0",
  "info": {
    "title": "dotnetCrptPortfel",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/session": {
      "get": {
        "summary": "Состояние сессии",
        "description": "Состояние доступа к рыночным инструментам. В Development csrf_token нужен для включения и закрытия сессии.",
        "responses": {
          "200": {
            "description": "Успешный ответ"
          },
          "default": {
            "description": "Ошибка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/market-tools": {
      "post": {
        "summary": "Включить рыночные инструменты (Development)",
        "description": "Создаёт локальную сессию для журнала рыночных запросов и кэша истории.",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Доступ включён."
          },
          "403": {
            "description": "Недействительный CSRF-токен."
          },
          "404": {
            "description": "Вне Development."
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Закрыть сессию рыночных инструментов",
        "responses": {
          "204": {
            "description": "Успешный ответ"
          },
          "default": {
            "description": "Ошибка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/public/market/coins": {
      "get": {
        "summary": "Каталог CoinGecko (Development)",
        "description": "Не принимает параметры портфеля.",
        "responses": {
          "200": {
            "description": "Каталог с публичными идентификаторами.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "symbol"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "symbol": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Вне Development."
          },
          "429": {
            "description": "Лимит запросов."
          },
          "502": {
            "description": "Данные CoinGecko недоступны."
          }
        }
      }
    },
    "/public/market/quotes": {
      "get": {
        "summary": "Публичные цены CoinGecko в USD (Development)",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 5000
            },
            "description": "До 100 уникальных CoinGecko ID через запятую."
          }
        ],
        "responses": {
          "200": {
            "description": "Котировки по найденным активам; цена передаётся точной десятичной строкой. Допускается опережение серверных часов до 60 секунд включительно, исходное время сохраняется. Активы без корректной цены или времени пропускаются.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "usd",
                      "as_of"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "usd": {
                        "type": "string"
                      },
                      "as_of": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Недопустимые идентификаторы."
          },
          "404": {
            "description": "Вне Development."
          },
          "429": {
            "description": "Лимит запросов."
          },
          "502": {
            "description": "Данные CoinGecko недоступны."
          }
        }
      }
    },
    "/internal/market/coinmarketcap/charts/{slug}": {
      "get": {
        "summary": "Кэш недельной истории CoinMarketCap в USD",
        "description": "Для сессии рыночных инструментов в Development. Первый вызов разрешает slug в cryptocurrencyId; следующий после общей паузы может загрузить историю. На каждый внешний GET CoinMarketCap действует общая пауза 30 секунд, на график одной монеты — час.",
        "security": [
          {
            "Session": []
          }
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[a-z0-9]+(?:-+[a-z0-9]+)*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Свежая, кэшированная или предыдущая история. Точки находятся в chart.data.points.",
            "headers": {
              "X-Chart-Cache": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "refreshed",
                    "hit",
                    "stale"
                  ]
                }
              },
              "X-Chart-Fetched-At": {
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "X-Chart-Next-Attempt-At": {
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "202": {
            "description": "ID сохранён. Повторить не раньше Retry-After.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный slug."
          },
          "401": {
            "description": "Требуется сессия рыночных инструментов."
          },
          "403": {
            "description": "Нет доступа к рыночным инструментам."
          },
          "404": {
            "description": "Монета не найдена либо маршрут не включён."
          },
          "429": {
            "description": "Истории в кэше нет, внешний запрос ограничен.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "502": {
            "description": "Истории в кэше нет, источник недоступен или вернул неожиданные данные."
          }
        }
      }
    },
    "/internal/market/coinmarketcap/monitor": {
      "get": {
        "summary": "Мониторинг запросов CoinMarketCap",
        "description": "Только чтение БД в Development: состояния монет, общая пауза и последние 100 внешних попыток. Просмотр не расходует лимит источника.",
        "security": [
          {
            "Session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Снимок мониторинга: as_of, global_next_attempt_at, coins, requests."
          },
          "401": {
            "description": "Требуется сессия рыночных инструментов."
          },
          "403": {
            "description": "Нет доступа к рыночным инструментам."
          },
          "404": {
            "description": "Маршрут не включён."
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Состояние API",
        "responses": {
          "200": {
            "description": "Успешный ответ"
          },
          "default": {
            "description": "Ошибка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Готовность базы",
        "responses": {
          "200": {
            "description": "Успешный ответ"
          },
          "default": {
            "description": "Ошибка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/market/requests": {
      "get": {
        "summary": "Общий журнал рыночных запросов (Development)",
        "description": "Последние 100 внешних GET к CoinGecko и CoinMarketCap. Возвращает источник, тип запроса, результат, HTTP-код источника, начало, окончание и краткий ответ. Сам мониторинг не делает запросов к источникам.",
        "security": [
          {
            "Session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Снимок мониторинга: as_of, global_next_attempt_at, coins, requests."
          },
          "401": {
            "description": "Требуется сессия рыночных инструментов."
          },
          "403": {
            "description": "Нет доступа к рыночным инструментам."
          },
          "404": {
            "description": "Вне Development."
          }
        }
      }
    },
    "/internal/market/coinmarketcap/cached/{slug}": {
      "get": {
        "summary": "Полный JSON последнего сохранённого графика CoinMarketCap",
        "description": "Только чтение кэша. Не запускает запрос к источнику даже при устаревших данных.",
        "security": [
          {
            "Session": []
          }
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[a-z0-9]+(?:-+[a-z0-9]+)*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Сохранённые platformInfo и chart без округления чисел."
          },
          "400": {
            "description": "Некорректный slug."
          },
          "401": {
            "description": "Требуется сессия рыночных инструментов."
          },
          "404": {
            "description": "Нет сохранённого графика либо маршрут не включён."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "portfel-dev"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          },
          "details": {}
        }
      }
    }
  }
}
