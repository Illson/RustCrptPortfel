              "running",
              "succeeded",
              "retry_wait",
              "failed",
              "blocked",
              "cancelled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "block_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
